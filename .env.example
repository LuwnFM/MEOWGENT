# Серверный API-ключ от OpenRouter (Никогда не улетит в гитхаб)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Пароль для доступа к вашему интерфейсу (Придумываете сами)
APP_ACCESS_CODE=your_secret_access_password_here

# Модель по умолчанию (GLM 5.2 от Z.ai бесплатная)
DEFAULT_MODEL=z-ai/glm-5.2:free

# Neon is tried first by the routing database adapter.
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/database?sslmode=require

# Vercel Postgres is used automatically if Neon is unavailable.
POSTGRES_URL=postgresql://user:password@host-pooler.region.postgres.vercel-storage.com/database
# POSTGRES_URL_NON_POOLING=postgresql://user:password@host.region.postgres.vercel-storage.com/database
