# Серверный API-ключ от OpenRouter (Никогда не улетит в гитхаб)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Пароль для доступа к вашему интерфейсу (Придумываете сами)
APP_ACCESS_CODE=your_secret_access_password_here

# Координатор: сначала GLM 5.2 Free, worker сам проверяет доступность и выбирает fallback.
# These IDs are preferences only: the live OpenRouter catalog decides availability and price.
OPENROUTER_PREFERRED_MODELS=z-ai/glm-5.2:free,openai/gpt-oss-20b:free,deepseek/deepseek-v3.2
OPENROUTER_MAX_ESTIMATED_USD_PER_REQUEST=0.01
# Worker uses live catalog + the same budget model preferences.
AGENT_MODEL=
# Optional independent providers; leave API keys unset to disable them.
# GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Never commit real keys; set them only in your runtime secrets.

# Neon is tried first by the routing database adapter.
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/database?sslmode=require

# Vercel Postgres is used automatically if Neon is unavailable.
POSTGRES_URL=postgresql://user:password@host-pooler.region.postgres.vercel-storage.com/database
# POSTGRES_URL_NON_POOLING=postgresql://user:password@host.region.postgres.vercel-storage.com/database

# S3-compatible storage (AWS S3, Cloudflare R2, MinIO, etc.)
S3_BUCKET=agent-files
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=false

# Redis/Inngest
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE=agent:jobs
INNGEST_EVENT_KEY=replace-me
